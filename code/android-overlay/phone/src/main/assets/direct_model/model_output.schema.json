    "service": {"anyOf": [
      {"type": "null"},
      {"type": "object", "properties": {
        "mode": {"type": "string", "enum": ["AWARENESS", "DECISION", "PREPARATION", "EXECUTION"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 40, "description": "Short Chinese title for glasses, at most 40 Unicode characters."},
        "body": {"type": "string", "minLength": 1, "maxLength": 140, "description": "Concise Chinese service, preferably 35-55 characters; hard limit 140 Unicode characters."}
