{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opstate.local/schema/inference_response_v2.schema.json",
  "type": "object",
  "required": [
    "request_id",
    "decision_id",
    "decision",
    "service",
    "evidence_refs",
    "produced_at_epoch_ms",
    "expires_at_epoch_ms"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "SERVICE",
        "NO_SERVICE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "service": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "mode",
            "title",
            "body"
          ],
          "properties": {
            "mode": {
              "enum": [
                "AWARENESS",
                "DECISION",
                "PREPARATION",
                "EXECUTION"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "produced_at_epoch_ms": {
      "type": "integer"
    },
    "expires_at_epoch_ms": {
      "type": "integer"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "SERVICE"
          }
        }
      },
      "then": {
        "properties": {
          "service": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "NO_SERVICE"
          }
        }
      },
      "then": {
        "properties": {
          "service": {
            "const": null
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
