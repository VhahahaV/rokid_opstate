<resources>
    <style name="GlassesTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- The panel's own emitter hue: it is the only colour that reaches the eye, so the framework's
             accent is matched to it rather than to the brand mint. -->
        <item name="android:colorAccent">#4CFF97</item>
    </style>
</resources>
